# ============================================================
#  nodeloc2tg — переменные окружения
#  Скопируй этот файл в .env и заполни своими значениями
# ============================================================

# --- Telegram ---
# 1. Создай бота через @BotFather → получишь токен
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# 2. ID канала куда бот постит.
#    - Для публичного канала: @username канала (например @my_nodeloc)
#    - Для приватного:        числовой ID, начинается с -100...
#      Узнать ID: добавь @userinfobot в канал как админа, он пришлёт ID,
#      затем убери его. Числовой ID приватного канала обычно вида -1001234567890.
CHANNEL_ID=@your_channel_username

# --- Источник ---
# Базовый URL форума NodeLoc (на Discourse)
FORUM_BASE=https://www.nodeloc.com

# --- Поведение ---
# Интервал опроса форума, секунды. NodeLoc активный — 300с (5 мин) разумно.
POLL_INTERVAL=300

# Сколько новых тем тянуть за один poll (Discourse /latest.json отдаёт ~30).
LATEST_LIMIT=30

# Сколько первых постов запостить при САМОМ ПЕРВОМ старте (backfill).
# Иначе при первом пуске бот попытается вывалить в канал десятки старых тем.
# 0 = не постить ничего из прошлого, только действительно новые (рекомендуется).
INITIAL_BACKFILL=0

# Минимальная длина текста поста (символов), чтобы вообще постить.
# Фильтрует пустые/ссылочные темы.
MIN_BODY_LENGTH=80

# Максимальный возраст темы в ЧАСАХ от created_at. NodeLoc бампает темы
# в /latest при любом ответе, поэтому 6-дневная тема может висеть в топе.
# Берём только действительно свежие темы по дате создания.
# 24 = постить темы не старше суток. 0 = не применять фильтр возраста.
MAX_TOPIC_AGE_HOURS=24

# Белый список ID категорий NodeLoc (через запятую). Постим только темы из
# этих категорий — фильтрует бытовуху (вопросы по жизни, спорт, медиа).
# По умолчанию: AI, VPS, хостинг, домены, email, технологии, программирование,
# виртуальные карты, скидки/сделки, розыгрыши.
# Чтобы ВЫКЛЮЧИТЬ фильтр (брать все категории): ALLOWED_CATEGORY_IDS=all
# Узнать ID категории: открой её на NodeLoc, ID в URL, либо см. config.py.
ALLOWED_CATEGORY_IDS=

# Таймаут HTTP-запросов, секунды
HTTP_TIMEOUT=20

# User-Agent для запросов к форуму
USER_AGENT=Mozilla/5.0 (compatible; nodeloc2tg/1.0)

# --- Перевод ---
# Задержка между вызовами Google Translate, мс (чтобы не словить 429)
TRANSLATE_DELAY_MS=600
# Сколько символов переводить из тела поста (обрезка, чтобы не превышать лимиты TG)
MAX_BODY_CHARS=1500
# Лимит подписи под фото (TG жёстко ≤1024; по умолчанию оставляем запас)
MAX_CAPTION_CHARS=900

# --- Логирование ---
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
